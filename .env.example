# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# MySQL source
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=moviedb
DB_USER=root
DB_PASS=
DB_TABLE=movies

# Algolia destination
# Use a key with addObject + settings ACLs (NOT the search-only key).
ALGOLIA_APP_ID=
ALGOLIA_WRITE_API_KEY=
ALGOLIA_INDEX_NAME=Wendy_movie

SYNC_BATCH_SIZE=1000
